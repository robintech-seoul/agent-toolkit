# TEMPLATE — Vite/React (or any static-bundler) SPA served by nginx on Robin-Cloud.
# The agent adapts the <PLACEHOLDERS> to the customer's repo. Key Robin-Cloud rules:
#   • Listen on 8080 (Robin-Cloud's default containerPort; non-privileged).
#   • Multi-stage: build with node, serve the static bundle with nginx:alpine.
#   • Build context = REPO ROOT if the package imports a sibling (shared UI pkg,
#     alias like @ds → ../design-system) or is in a pnpm/yarn/npm workspace —
#     the build needs those files. Single self-contained package → context can be
#     the package dir.  Build with:  docker build -f <MODULE>/Dockerfile . (root)
#
# Ports: 8080 everywhere (matches the deploy-config default → no per-port tweaking).

FROM node:22-slim AS build
RUN corepack enable                     # uses the package.json "packageManager" (pnpm/yarn)
WORKDIR /repo

# --- deps (cached until manifests/lockfile change) ---
# Monorepo: copy the workspace manifests + EVERY workspace package.json so the
# install resolves, then install. Single package: copy just its package.json + lock.
COPY <WORKSPACE_MANIFESTS: e.g. pnpm-workspace.yaml package.json pnpm-lock.yaml> ./
COPY <MODULE>/package.json <MODULE>/
# COPY <other-workspace-pkgs>/package.json <other-workspace-pkgs>/   # if a monorepo
RUN corepack pnpm install --frozen-lockfile

# --- sources: the app + any sibling packages it imports at build time ---
COPY <MODULE>/ <MODULE>/
# COPY <shared-pkg>/ <shared-pkg>/         # e.g. a design-system imported via alias

# --- public build-time config (baked into the bundle; NO secrets) ---
# The frontend calls the API same-origin at /api by default → keep VITE_API_BASE_URL
# relative. List every VITE_* the app reads (grep import.meta.env.VITE_ in src).
ARG VITE_API_BASE_URL=/api/v1
# ARG VITE_<OTHER>=              # add the rest; empty default = feature degrades gracefully
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN corepack pnpm --filter <MODULE> build          # → <MODULE>/dist

# --- serve ---
FROM nginx:alpine AS serve
COPY <MODULE>/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/<MODULE>/dist /usr/share/nginx/html
# If this SPA is exposed at a SUBPATH (e.g. /admin), instead copy to a subdir and
# set Vite `base: '/admin/'` + router basename — see nginx-subpath.conf.
EXPOSE 8080
